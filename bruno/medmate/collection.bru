meta {
  name: medmate
}

auth {
  mode: none
}

script:pre-request {
  function pathnameOf(url) {
    let value = String(url || "").trim();
    if (typeof bru.interpolate === "function") {
      try {
        const interpolated = bru.interpolate(value);
        if (interpolated) {
          value = String(interpolated).trim();
        }
      } catch (error) {
        // Bruno substitutes {{vars}} after this script. Keep the raw url.
      }
    }
    let pathname = value;
    try {
      pathname = new URL(value).pathname;
    } catch (error) {
      const withoutQuery = value.split("?")[0].split("#")[0];
      const slash = withoutQuery.indexOf("/");
      pathname = slash === -1 ? withoutQuery : withoutQuery.slice(slash);
    }
    if (pathname.length > 1 && pathname.endsWith("/")) {
      pathname = pathname.slice(0, -1);
    }
    return pathname || "/";
  }

  function skipsUserAuth(pathname) {
    return pathname.startsWith("/actuator")
      || pathname === "/auth/otp/send"
      || pathname === "/auth/otp/verify"
      || pathname === "/auth/pin"
      || pathname === "/auth/refresh"
      || pathname === "/auth/sign-out"
      || pathname === "/auth/admin-bootstrap";
  }

  function readPayload(response) {
    const data = response && response.data;
    if (typeof data === "string") {
      try {
        return JSON.parse(data);
      } catch (error) {
        return null;
      }
    }
    return data || null;
  }

  function saveSession(body) {
    if (!body || !body.accessToken || !body.refreshToken) {
      return;
    }
    bru.setEnvVar("accessToken", body.accessToken);
    bru.setEnvVar("refreshToken", body.refreshToken);
    const seconds = Number(body.expiresIn || 900);
    bru.setEnvVar("accessTokenExpiresAt", String(Date.now() + seconds * 1000));
    const account = body.account || {};
    if (account.id) {
      bru.setEnvVar("accountId", account.id);
    }
    if (account.pharmacyId) {
      bru.setEnvVar("pharmacyId", account.pharmacyId);
    }
  }

  async function refreshSession() {
    const refreshToken = bru.getEnvVar("refreshToken");
    if (!refreshToken) {
      return "";
    }
    try {
      const response = await bru.sendRequest({
        method: "POST",
        url: bru.getEnvVar("baseUrl") + "/auth/refresh",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
          "X-Request-Id": bru.getEnvVar("exampleRequestId") || "req-bruno-refresh"
        },
        data: { refreshToken: refreshToken }
      });
      const body = readPayload(response);
      if (!response || response.status !== 200 || !body || !body.accessToken) {
        bru.setEnvVar("accessToken", "");
        bru.setEnvVar("refreshToken", "");
        bru.setEnvVar("accessTokenExpiresAt", "0");
        return "";
      }
      saveSession(body);
      return body.accessToken;
    } catch (error) {
      console.log("Refresh failed before the request");
      bru.setEnvVar("accessToken", "");
      bru.setEnvVar("refreshToken", "");
      bru.setEnvVar("accessTokenExpiresAt", "0");
      return "";
    }
  }

  const pathname = pathnameOf(req.getUrl());
  if (!skipsUserAuth(pathname)) {
    const accessToken = bru.getEnvVar("accessToken") || "";
    const refreshToken = bru.getEnvVar("refreshToken") || "";
    const expiresAt = Number(bru.getEnvVar("accessTokenExpiresAt") || 0);
    const expired = !accessToken || Date.now() >= expiresAt - 15000;
    const bearer = expired ? (refreshToken ? await refreshSession() : "") : accessToken;
    if (bearer) {
      req.setHeader("Authorization", "Bearer " + bearer);
    }
  }
}

script:post-response {
  function pathnameOf(url) {
    let value = String(url || "").trim();
    if (typeof bru.interpolate === "function") {
      try {
        const interpolated = bru.interpolate(value);
        if (interpolated) {
          value = String(interpolated).trim();
        }
      } catch (error) {
        // Bruno substitutes {{vars}} after this script. Keep the raw url.
      }
    }
    let pathname = value;
    try {
      pathname = new URL(value).pathname;
    } catch (error) {
      const withoutQuery = value.split("?")[0].split("#")[0];
      const slash = withoutQuery.indexOf("/");
      pathname = slash === -1 ? withoutQuery : withoutQuery.slice(slash);
    }
    if (pathname.length > 1 && pathname.endsWith("/")) {
      pathname = pathname.slice(0, -1);
    }
    return pathname || "/";
  }

  function responseBody() {
    const body = res.getBody();
    if (typeof body === "string") {
      try {
        return JSON.parse(body);
      } catch (error) {
        return null;
      }
    }
    return body;
  }

  function readPayload(response) {
    const data = response && response.data;
    if (typeof data === "string") {
      try {
        return JSON.parse(data);
      } catch (error) {
        return null;
      }
    }
    return data || null;
  }

  function saveSession(body) {
    if (!body || !body.accessToken || !body.refreshToken) {
      return;
    }
    bru.setEnvVar("accessToken", body.accessToken);
    bru.setEnvVar("refreshToken", body.refreshToken);
    const seconds = Number(body.expiresIn || 900);
    bru.setEnvVar("accessTokenExpiresAt", String(Date.now() + seconds * 1000));
    const account = body.account || {};
    if (account.id) {
      bru.setEnvVar("accountId", account.id);
    }
    if (account.pharmacyId) {
      bru.setEnvVar("pharmacyId", account.pharmacyId);
    }
  }

  function clearSession() {
    bru.setEnvVar("accessToken", "");
    bru.setEnvVar("refreshToken", "");
    bru.setEnvVar("accessTokenExpiresAt", "0");
  }

  async function refreshSession() {
    const refreshToken = bru.getEnvVar("refreshToken");
    if (!refreshToken) {
      return false;
    }
    try {
      const response = await bru.sendRequest({
        method: "POST",
        url: bru.getEnvVar("baseUrl") + "/auth/refresh",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
          "X-Request-Id": bru.getEnvVar("exampleRequestId") || "req-bruno-refresh"
        },
        data: { refreshToken: refreshToken }
      });
      const body = readPayload(response);
      if (!response || response.status !== 200 || !body || !body.accessToken) {
        clearSession();
        return false;
      }
      saveSession(body);
      return true;
    } catch (error) {
      console.log("Refresh failed after a rejected session");
      return false;
    }
  }

  const pathname = pathnameOf(req.getUrl());
  const status = res.getStatus();
  const body = responseBody();
  saveSession(body);

  if (pathname === "/auth/sign-out" && status === 204) {
    clearSession();
  }

  if (body && body.id && (status === 200 || status === 201)) {
    if (pathname === "/staff" || pathname.startsWith("/staff/")) {
      bru.setEnvVar("platformStaffId", body.id);
    }
    if (pathname === "/pharmacy/staff" || pathname.startsWith("/pharmacy/staff/")) {
      bru.setEnvVar("pharmacyStaffId", body.id);
    }
  }

  if (pathname === "/pharmacy/employees" && status === 201 && body && body.employee && body.employee.id) {
    bru.setEnvVar("employeeCode", body.employee.id);
  }

  if (pathname === "/pharmacy/distributors" && status === 201 && body && body.distributor && body.distributor.id) {
    bru.setEnvVar("distributorCode", body.distributor.id);
  }

  const sessionRejected = status === 401 && body && body.detail === "Session was not accepted";
  const canRefresh = pathname !== "/auth/refresh" && pathname !== "/auth/sign-out";
  if (sessionRejected && canRefresh && bru.getEnvVar("refreshToken")) {
    await refreshSession();
  }
}

docs {
  One folder per module, one request file per operation.
  Example values live in environments: baseUrl, examplePharmacyId, examplePhone, and exampleRequestId.
  The collection script stores accessToken, refreshToken, and accessTokenExpiresAt from any login or refresh response.
  It sends Authorization: Bearer on protected calls, and calls POST /auth/refresh when the access token is expired or the server rejects the session.
  Send OTP stores the latest mock code in otpCode. Verify OTP sends that value. Start `make sms-mock` first.
  Record only endpoints the running server serves.
}
