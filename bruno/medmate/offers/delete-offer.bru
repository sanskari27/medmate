meta {
  name: Delete offer
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/pharmacy/offers/OFR-001
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with offers:delete, removes an offer. The number is not reused.
}
