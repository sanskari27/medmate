meta {
  name: List offers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/offers
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with offers:read, lists offers newest first and the inventory medicines they can target.
}
