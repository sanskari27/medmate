meta {
  name: Create bill
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pharmacy/bills
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "patientName": "Ada",
    "patientPhone": "9886012345",
    "payMode": "cash",
    "lines": [
      {
        "productId": "med-a",
        "batchNo": "B1",
        "qty": 1
      }
    ]
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(201);
    expect(res.body.bill.payMode).to.equal("cash");
    expect(res.body.bill.number).to.be.a("string");
  });
}

docs {
  An approved owner, or staff with billing:create, posts a cash sale. The server assigns the invoice prefix plus 0001 for the first bill and recomputes the price.
}
