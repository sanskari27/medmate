meta {
  name: List purchases
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/purchases
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with purchases:read, lists purchase and return documents for this pharmacy.
}
