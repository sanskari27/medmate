meta {
  name: Search medicines
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/pharmacy/medicines/search?q=crocin
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with purchases:create, searches the medicine catalog. The query needs two characters.
}
