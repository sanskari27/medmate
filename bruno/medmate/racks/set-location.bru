meta {
  name: Set location
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/pharmacy/inventory/DR100/location
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "rack": "A3-12",
    "rackAlt": "B1"
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with racks:update, sets the primary code and the second slot. An absent field is left as it is.
}
