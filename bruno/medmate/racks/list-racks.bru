meta {
  name: List racks
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/racks
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with racks:read, lists registry codes and each product placement.
}
