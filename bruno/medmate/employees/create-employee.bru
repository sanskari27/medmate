meta {
  name: Create employee
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pharmacy/employees
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "name": "Anjali Menon",
    "phone": "{{examplePhone}}",
    "position": "Pharmacist"
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved owner, or staff with employees:create, adds a person. The server assigns EMP-001 for the first person in that pharmacy.
  A 201 response stores employeeCode from employee.id.
}
