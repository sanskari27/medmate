meta {
  name: List payments
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/pharmacy/distributors/{{distributorCode}}/payments?page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.payments).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
    expect(res.body.total).to.be.a("number");
  });
}

docs {
  An approved owner, or staff with distributors:read, lists one distributor's ledger oldest first.
}
