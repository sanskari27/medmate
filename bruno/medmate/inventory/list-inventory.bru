meta {
  name: List inventory
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/inventory?page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.have.property("products");
    expect(res.body).to.have.property("summary");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
    expect(res.body.total).to.be.a("number");
  });
}

docs {
  An approved owner, or staff with inventory:read, lists stocked medicines and their batches.
}
