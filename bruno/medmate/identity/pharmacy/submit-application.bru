meta {
  name: Submit application
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pharmacy/application
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:multipart-form {
  name: Care Pharmacy
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  The owner sends one complete multipart application. A missing session is rejected before field checks.
}
