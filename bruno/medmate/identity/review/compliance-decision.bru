meta {
  name: Compliance decision
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pharmacy-applications/{{examplePharmacyId}}/compliance-decision
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "decision": "reject",
    "comment": "Missing seal"
  }
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  Compliance staff or an admin record the first decision. examplePharmacyId {{examplePharmacyId}} stands in for a real pharmacy.
}
