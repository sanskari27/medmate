meta {
  name: List applications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy-applications?status=pending_compliance
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  Admin and compliance staff list pharmacies waiting for review.
}
