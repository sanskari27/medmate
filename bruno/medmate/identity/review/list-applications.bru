meta {
  name: List applications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy-applications?status=pending_compliance&page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.applications).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
    expect(res.body.total).to.be.a("number");
  });
}

docs {
  Admin and compliance staff list pharmacies waiting for review.
  The collection script attaches the saved access token.
}
