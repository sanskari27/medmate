meta {
  name: List applications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy-applications?status=pending_compliance
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  Admin and compliance staff list pharmacies waiting for review.
  The collection script attaches the saved access token.
}
