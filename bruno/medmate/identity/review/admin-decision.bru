meta {
  name: Admin decision
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/pharmacy-applications/{{pharmacyId}}/admin-decision
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "decision": "approve",
    "comment": "Approved"
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  Only an admin records the final decision, and only after compliance approval.
  pharmacyId is filled when a pharmacy account signs in. The collection script attaches the saved access token.
}
