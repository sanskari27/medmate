meta {
  name: Send OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/otp/send
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}",
    "accountType": "customer",
    "purpose": "login"
  }
}

assert {
  res.status: eq 200
  res.body.mode: eq otp
}

docs {
  Sends a login code for a customer. Start `make sms-mock` first when the API uses the local SMS URL.
  examplePhone {{examplePhone}} is the sample mobile.
}
