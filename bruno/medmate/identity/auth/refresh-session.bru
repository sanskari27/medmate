meta {
  name: Refresh session
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("saved refresh token rotates", function() {
    if (!bru.getEnvVar("refreshToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string");
    expect(res.getBody().refreshToken).to.be.a("string");
  });
}

docs {
  Uses the saved refreshToken, rotates it, and stores the new accessToken and refreshToken.
  A refresh token lasts 30 days.
}
