meta {
  name: Sign out
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/sign-out
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "refreshToken": "missing"
  }
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  Sign-out revokes the presented refresh token. The access token stays valid until it expires.
}
