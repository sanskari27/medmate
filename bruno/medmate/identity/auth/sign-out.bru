meta {
  name: Sign out
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/sign-out
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setEnvVar("accessToken", "");
    bru.setEnvVar("refreshToken", "");
    bru.setEnvVar("accessTokenExpiresAt", "0");
  }
}

tests {
  test("saved refresh token is revoked", function() {
    if (res.getStatus() === 204) {
      expect(bru.getEnvVar("refreshToken")).to.equal("");
      expect(bru.getEnvVar("accessToken")).to.equal("");
      return;
    }
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Revokes the saved refreshToken and clears accessToken and refreshToken.
  The access token would stay valid until it expires. This collection clears it so later calls do not reuse it.
}
