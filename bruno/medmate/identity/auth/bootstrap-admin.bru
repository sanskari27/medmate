meta {
  name: Bootstrap admin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/admin-bootstrap
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminBootstrapToken}}
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}"
  }
}

tests {
  test("bootstrap token is accepted when it is configured", function() {
    if (!bru.getEnvVar("adminBootstrapToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accountId).to.be.a("string");
  });
}

docs {
  Sends adminBootstrapToken, not the user access token. Local value is local-bootstrap.
  A user JWT cannot create an admin.
}
