meta {
  name: Bootstrap admin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/admin-bootstrap
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}"
  }
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  The GitHub workflow Medmate admin calls this route with the bootstrap token. A user JWT cannot create an admin.
}
