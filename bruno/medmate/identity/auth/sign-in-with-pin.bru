meta {
  name: Sign in with PIN
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/pin
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}",
    "accountType": "pharmacy",
    "pin": "{{pin}}"
  }
}

tests {
  test("PIN login stores a session or rejects the PIN", function() {
    const status = res.getStatus();
    expect([200, 401]).to.include(status);
    if (status === 200) {
      expect(res.getBody().accessToken).to.be.a("string");
      expect(res.getBody().refreshToken).to.be.a("string");
    }
  });
}

docs {
  PIN login is only for an approved pharmacy owner who has already set a PIN.
  A 200 response stores accessToken and refreshToken. pin comes from the environment.
}
