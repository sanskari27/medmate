meta {
  name: Sign in with PIN
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/pin
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}",
    "accountType": "pharmacy",
    "pin": "0000"
  }
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  PIN login is only for an approved pharmacy owner who has already set a PIN.
}
