meta {
  name: Create platform staff
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/staff
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}",
    "displayName": "Compliance desk",
    "subtypes": ["compliance"]
  }
}

assert {
  res.status: eq 401
  res.body.title: eq Unauthorized
}

docs {
  An admin creates platform staff. Subtypes grant their module for every pharmacy.
}
