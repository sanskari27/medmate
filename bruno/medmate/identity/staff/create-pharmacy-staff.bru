meta {
  name: Create pharmacy staff
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/pharmacy/staff
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "phone": "{{examplePhone}}",
    "displayName": "Counter",
    "permissions": ["inventory:read"]
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  An approved pharmacy owner grants keys such as inventory:read inside that pharmacy.
  A 201 response stores pharmacyStaffId. The collection script attaches the saved access token.
}
