meta {
  name: Update pharmacy staff
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/pharmacy/staff/{{pharmacyStaffId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "permissions": ["inventory:read", "billing:create"]
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  The owner replaces the permission keys for one staff account.
  pharmacyStaffId is stored by Create pharmacy staff. The collection script attaches the saved access token.
}
