meta {
  name: List lists
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/inventory-prep
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("the caller sees only their lists", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(403);
      expect(res.body.detail).to.equal("This action is not allowed.");
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.lists).to.be.an("array");
  });
}

docs {
  Newest updated time first. Another account's lists are absent.
}
