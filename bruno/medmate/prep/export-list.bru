meta {
  name: Export list
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/inventory-prep/{{prepListId}}/export
  body: none
  auth: none
}

headers {
  Accept: text/csv, application/problem+json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("an unfinished saved row is refused", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(403);
      return;
    }
    expect(res.getStatus()).to.equal(400);
    expect(res.body.detail).to.equal("Row 1: Batch number is required");
  });
}

docs {
  Run after Save lines. The sample row has no batch, so export names that row and leaves the list unchanged.
}
