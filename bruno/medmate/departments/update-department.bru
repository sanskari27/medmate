meta {
  name: Update department
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/pharmacy/departments/{{departmentId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-Id: {{exampleRequestId}}
}

body:json {
  {
    "description": "Inpatient cardiology",
    "displayOrder": 2
  }
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
    }
  });
}

docs {
  departments:update changes the department, including the parent, the active flag, and the display order.
  Run Create department first so departmentId is stored. A retail pharmacy receives 403.
}
