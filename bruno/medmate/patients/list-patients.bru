meta {
  name: List patients
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/patients?page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.have.property("patients");
    expect(res.body).to.have.property("summary");
    expect(res.body).to.have.property("aging");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
  });
}

docs {
  An approved owner, or staff with patients:read, lists the patient directory for this pharmacy.
}
