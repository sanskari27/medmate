meta {
  name: Get readiness
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/actuator/health/readiness
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

docs {
  Process readiness. Traffic should wait until this status is UP.
}
