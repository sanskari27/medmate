meta {
  name: List sales
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pharmacy/sales?page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.have.property("sales");
    expect(res.body).to.have.property("stats");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
    expect(res.body.total).to.be.a("number");
  });
}

docs {
  An approved owner, or staff with sales:read, lists invoices and returns for this pharmacy.
}
