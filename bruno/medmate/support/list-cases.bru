meta {
  name: List cases
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/support/cases?page=1&size=25
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-Id: {{exampleRequestId}}
}

tests {
  test("saved session is sent", function() {
    if (!bru.getEnvVar("accessToken")) {
      expect(res.getStatus()).to.equal(401);
      return;
    }
    expect(res.getStatus()).to.equal(200);
    expect(res.body.cases).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(25);
    expect(res.body.total).to.be.a("number");
  });
}

docs {
  An owner sees that pharmacy's cases. Admin and support see every pharmacy.
}
