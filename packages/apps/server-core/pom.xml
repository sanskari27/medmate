<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.medmate</groupId>
  <artifactId>server-core</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>server-core-kernel</module>
    <module>server-core-identity</module>
    <module>server-core-files</module>
    <module>server-core-pharmacy</module>
    <module>server-core-master</module>
    <module>server-core-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <aws.sdk.version>2.32.20</aws.sdk.version>
    <!-- spring-boot:run is invoked on every reactor module; only the app has a main class. -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
    <!-- Boot 3.5.6 manages 1.21.3, which speaks Docker API 1.32. Current runners reject that. -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.medmate</groupId>
        <artifactId>server-core-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medmate</groupId>
        <artifactId>server-core-identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medmate</groupId>
        <artifactId>server-core-files</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medmate</groupId>
        <artifactId>server-core-pharmacy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.medmate</groupId>
        <artifactId>server-core-master</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>1.79</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
