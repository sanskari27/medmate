<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.medmate</groupId>
    <artifactId>medmate-server</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>medmate-server-app</artifactId>
  <name>medmate-server-app</name>

  <dependencies>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-shared</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-identity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-employees</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-distributors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-stock</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-offers</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-billing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-crm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-expenses</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-reports</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.medmate</groupId>
      <artifactId>medmate-server-dashboard</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>medmate-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
